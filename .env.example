# Copy to .env and adjust. No secrets are required by this project.

# Root folder for raw/processed datasets (defaults to <repo>/data/raw and <repo>/data/processed)
FLOOD_DATA_DIR=F:/Disaster/data/raw
FLOOD_PROCESSED_DIR=F:/Disaster/data/processed

# Folder holding trained runs (checkpoints, history, evaluation)
FLOOD_ARTIFACTS_DIR=F:/Disaster/artifacts

# Cache for OpenStreetMap road graphs (GraphML) so routing works offline after first fetch
FLOOD_OSM_CACHE=F:/Disaster/data/osm_cache

# Backend
FLOOD_API_HOST=127.0.0.1
FLOOD_API_PORT=8000
FLOOD_MAX_UPLOAD_MB=40
FLOOD_MAX_IMAGE_PIXELS=4194304
# Inference device: auto | cuda | cpu
FLOOD_DEVICE=auto
# Allow the backend to query the Overpass API for road networks not yet cached (true/false)
FLOOD_ALLOW_OSM_DOWNLOAD=true
# Comma-separated CORS origins for the dev frontend
FLOOD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
